# Copy to ".env" (never commit .env). Used by docker-compose.yml

# SQL Server "sa" password: min 8 chars, upper + lower + digit + symbol
SA_PASSWORD=ChangeMe_Str0ng!Pass

# Shared secret between the MVC app and the API (any long random string)
API_KEY=change-me-to-a-long-random-string

# Azure Portal > Storage account > Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net
